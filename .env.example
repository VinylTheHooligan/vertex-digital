# Environment variables
# Copy this file to .env and fill in your values

# Database Configuration
# SQLite file-based database path
DATABASE_URL="file:./prisma/dev.db"

# Admin Authentication
# Admin username for login page
ADMIN_USERNAME=admin

# Admin password hash generated with bcryptjs
# Example: $2b$12$... (use bcryptjs to generate)
# Command: npx bcryptjs hash "your-password" 10
ADMIN_PASSWORD_HASH=$2b$12$example_hash_here

# Session Configuration
# Secret key for iron-session (minimum 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your-32-character-minimum-secret-key-here-12345678

# Cloudflare Turnstile Configuration
# Site key for public widget (development: 1x00000000000000000000AA)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Secret key for server-side validation (development: 1x0000000000000000000000000000000AA)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Environment
NODE_ENV=development
