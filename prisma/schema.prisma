generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma/client"
}

datasource db {
  provider = "sqlite"
}

model Project {
  id            Int           @id @default(autoincrement())
  image         String
  name          String        @unique
  description   String        
  technologies  Technology[]
  createdAt     DateTime      @default(now())
  startedAt     DateTime
  endedAt       DateTime?
  github        String?
  web           String?
}

model Technology {
  id            Int           @id @default(autoincrement())
  name          String        @unique
  logo          String
  project       Project[]       
}

model Contact {
  id            Int           @id @default(autoincrement())
  ip            String        
  from          String        
  subject       String        
  content       String        
  createdAt     DateTime      @default(now())
}

enum BanType {
  email
  ip
}

model Ban {
  id            Int           @id @default(autoincrement())
  type          BanType
  value         String        
  reason        String?
  createdAt     DateTime      @default(now())

  @@unique([type, value])
}

model LoginAttempt {
  id            Int           @id @default(autoincrement())
  ip            String        
  createdAt     DateTime      @default(now())
}